# Copy to .env and adjust. docker-compose reads these, and so does the server
# itself (config.LoadEnvFiles reads ./.env and ~/.config/app/.env).
#
# Keep the canonical copy in the central store, not in git:
#   bato secrets push <name>-server -f .env     # from this directory
#   bato secrets pull <name>-server             # on whatever host runs it

# Identity comes from bato-auth. BATO_AUTH_URL is the address this server uses
# to verify requests; BATO_AUTH_PUBLIC_URL is where browsers go to sign in.
# Leaving BATO_AUTH_URL blank puts the server in loopback-only dev mode — which
# is correct locally and broken-on-purpose for anything deployed.
BATO_AUTH_URL=http://CHANGE-ME-SERVER-IP:42111
BATO_AUTH_PUBLIC_URL=https://auth.bato.lan

# Host port to publish the container on. Must match the "port" claimed in
# BatoApps/PORTS.md and set in bato.json — the container always listens on 8080.
APP_HOST_PORT=8080

# Where the server keeps data it expects to find after a restart. The Dockerfile
# already sets this to /data; override it only when running outside a container.
# APP_DATA_DIR=./data

# Build version label baked into the image.
VERSION=compose
