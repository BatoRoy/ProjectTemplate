{
  "name": "app-server",
  "type": "backend",
  "description": "Backend for the app",
  "env": {
    "PATH": "~/.local/bin:/usr/local/bin:/usr/bin:/bin",
    "APP_DATA_DIR": "~/.local/share/app"
  },
  "deploy": {
    "app": "AppServer",
    "image": "app-server",
    "project": "Bato",
    "environment": "production",
    "targetPort": 8080,
    "domain": "app.bato.lan",
    "env": ["BATO_AUTH_URL"],
    "volumes": [{ "name": "app-server-data", "path": "/data" }]
  }
}
