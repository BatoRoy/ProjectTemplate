+/// Touchscreen input as GPUI's raw [`TouchEvent`]s (the window's portable
+/// gesture recognizer turns them into taps, pans and long presses, as on the
+/// other platforms). Events are grouped per `wl_touch.frame`; positions are
+/// surface-local logical pixels, like the pointer's.
+impl Dispatch<wl_touch::WlTouch, ()> for WaylandClientStatePtr {
+    fn event(
+        this: &mut Self,
+        _: &wl_touch::WlTouch,
+        event: wl_touch::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let client = this.get_client();
+        let mut state = client.borrow_mut();
+        let touch = |id: i32, phase, position| TouchEvent {
+            id: TouchId(id as u32 as u64),
+            phase,
+            position,
+            ..Default::default()
+        };
+        match event {
+            wl_touch::Event::Down {
+                surface, id, x, y, ..
+            } => {
+                let Some(window) = get_window(&mut state, &surface.id()) else {
+                    return;
+                };
+                let position = point(px(x as f32), px(y as f32));
+                state.touch_points.insert(id, (window.clone(), position));
+                state
+                    .touch_frame
+                    .push((window, touch(id, TouchPhase::Started, position)));
+            }
+            wl_touch::Event::Motion { id, x, y, .. } => {
+                let position = point(px(x as f32), px(y as f32));
+                let Some((window, last)) = state.touch_points.get_mut(&id) else {
+                    return;
+                };
+                *last = position;
+                let window = window.clone();
+                // Only the latest motion of a point within a frame matters.
+                if let Some((_, pending)) = state.touch_frame.iter_mut().rev().find(|(_, e)| {
+                    e.id == TouchId(id as u32 as u64) && e.phase == TouchPhase::Moved
+                }) {
+                    pending.position = position;
+                } else {
+                    state
+                        .touch_frame
+                        .push((window, touch(id, TouchPhase::Moved, position)));
+                }
+            }
+            wl_touch::Event::Up { id, .. } => {
+                if let Some((window, position)) = state.touch_points.remove(&id) {
+                    state
+                        .touch_frame
+                        .push((window, touch(id, TouchPhase::Ended, position)));
+                }
+            }
+            wl_touch::Event::Frame => {
+                let events = std::mem::take(&mut state.touch_frame);
+                drop(state);
+                for (window, event) in events {
+                    window.handle_input(PlatformInput::Touch(event));
+                }
+            }
+            wl_touch::Event::Cancel => {
+                // The compositor took every current touch point (e.g. for a
+                // system gesture): they end now, without a click or a fling.
+                state.touch_frame.clear();
+                let points: Vec<_> = state.touch_points.drain().collect();
+                drop(state);
+                for (id, (window, position)) in points {
+                    window.handle_input(PlatformInput::Touch(touch(
+                        id,
+                        TouchPhase::Cancelled,
+                        position,
+                    )));
+                }
+            }
+            _ => {}
+        }
+    }
+}
