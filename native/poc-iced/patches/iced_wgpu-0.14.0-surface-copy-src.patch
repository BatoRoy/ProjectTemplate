From 00db48b687e957ac398a47988d2617475ae5ccc5 Mon Sep 17 00:00:00 2001
From: bato <bato@local>
Date: Fri, 13 Nov 2026 23:45:18 +0100
Subject: [PATCH] bato patch

---
 src/window/compositor.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/window/compositor.rs b/src/window/compositor.rs
index f612c80..9c69722 100644
--- a/src/window/compositor.rs
+++ b/src/window/compositor.rs
@@ -326,7 +326,9 @@ impl graphics::Compositor for Compositor {
         surface.configure(
             &self.engine.device,
             &wgpu::SurfaceConfiguration {
-                usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
+                // bato patch: COPY_SRC lets a custom primitive read the frame
+                // drawn so far (backdrop-filter: blur for modal scrims).
+                usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
                 format: self.format,
                 present_mode: self.settings.present_mode,
                 width,
-- 
