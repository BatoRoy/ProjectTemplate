# ── Frontend build & dependencies ─────────────────────────
app-client/frontend/dist/
app-client/build/bin/
**/node_modules/
app-client/frontend/package.json.md5

# ── Electron build output ─────────────────────────────────
dist/

# ── Release staging ───────────────────────────────────────
# `make stage-server` builds this whole directory, manifest included. Nothing in it is
# source.
deploy/

# ── Go binaries ────────────────────────────────────────────
app-server/app-server
app-server/app-server.exe

# ── Generic binary extensions ─────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── Go tooling output ──────────────────────────────────────
*.test
*.out

# ── OS / editor ────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ── Environment ────────────────────────────────────────────
.env
.env.*
# …but the example file is documentation, not a secret.
!app-server/.env.example

# ── Misc ───────────────────────────────────────────────────
tmp/
# tools/ is a scratch directory for downloaded binaries and one-off scripts, but the
# repo's own checked-in tooling lives there too and IS source.
#
# Note `tools/*`, not `tools/`: git does not descend into an excluded directory, so a
# negation inside one never applies and `!tools/check-desktop-manifest.mjs` would be
# silently dead. Excluding the contents instead is what makes the re-inclusions work.
#
# This matters more than it looks: new-app.sh exports a new app with `git archive`, so
# anything ignored here simply does not reach the scaffolded app — a checked-in tool
# that is not re-included here is missing from every app the template creates.
tools/*
!tools/check-desktop-manifest.mjs
*.AppImage
